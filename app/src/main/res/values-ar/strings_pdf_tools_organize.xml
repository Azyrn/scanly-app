    <string name="pdf_tool_split_action">تقسيم</string>
    <string name="pdf_tool_split_extract_action">استخراج صفحات</string>
    <string name="pdf_tool_split_delete_action">حذف صفحات</string>

    <!-- Split: result notes -->
    <plurals name="pdf_tool_split_oversized_pages">
        <item quantity="zero">%d صفحة تتجاوز حد الحجم وحدها، لذا تحصل على ملف خاص بها.</item>
        <item quantity="one">%d صفحة تتجاوز حد الحجم وحدها، لذا تحصل على ملف خاص بها.</item>
        <item quantity="two">%d صفحتان تتجاوزان حد الحجم وحدهما، لذا تحصل كل منهما على ملف خاص بها.</item>
        <item quantity="few">%d صفحات تتجاوز حد الحجم وحدها، لذا تحصل كل منها على ملف خاص بها.</item>
        <item quantity="many">%d صفحةً تتجاوز حد الحجم وحدها، لذا تحصل كل منها على ملف خاص بها.</item>
        <item quantity="other">%d صفحة تتجاوز حد الحجم وحدها، لذا تحصل على ملف خاص بها.</item>
    </plurals>
</resources>
