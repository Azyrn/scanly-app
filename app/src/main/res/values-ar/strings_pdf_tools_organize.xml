        <item quantity="zero">يحتفظ بـ %d صفحة</item>
        <item quantity="one">يحتفظ بـ %d صفحة</item>
        <item quantity="two">يُبقي %d صفحتين</item>
        <item quantity="few">يحتفظ بـ %d صفحات</item>
        <item quantity="many">يحتفظ بـ %d صفحة</item>
        <item quantity="other">يحتفظ بـ %d صفحة</item>
    </plurals>

