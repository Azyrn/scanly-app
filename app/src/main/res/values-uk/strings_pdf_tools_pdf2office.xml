<?xml version="1.0" encoding="utf-8"?>
<!-- PDF tools: PDF to Word, PDF to PowerPoint and PDF to Excel. -->
<resources>
    <!-- Options -->
    <string name="pdf2office_word_body">Текст, заголовки, списки та таблиці стають доступними для редагування у Word. Відскановані сторінки додаються як зображення.</string>
    <string name="pdf2office_word_action">Перетворити на Word</string>
    <string name="pdf2office_powerpoint_body">Кожна сторінка стає слайдом; її текст розміщується в редагованих блоках там, де він був на сторінці. Відскановані сторінки додаються як зображення.</string>
    <string name="pdf2office_powerpoint_action">Перетворити на PowerPoint</string>
    <string name="pdf2office_excel_body">Таблиці стають рядками й клітинками, аркуш на сторінку. Числа лишаються числами.</string>
    <string name="pdf2office_excel_action">Перетворити на Excel</string>

    <!-- Result notes -->
    <string name="pdf2office_simplified_word">Макет спрощено: текст і таблиці редаговані; шрифти, колонки, малюнки й зображення не перенесено.</string>
    <string name="pdf2office_simplified_powerpoint">Макет спрощено: текст редагований на місці; шрифти, малюнки й зображення не перенесено.</string>
    <plurals name="pdf2office_scanned_as_images">
        <item quantity="one">%d відскановану сторінку додано як зображення.</item>
        <item quantity="few">%d відскановані сторінки додано як зображення.</item>
        <item quantity="many">%d відсканованих сторінок додано як зображення.</item>
        <item quantity="other">%d відскановані сторінки додано як зображення.</item>
    </plurals>
    <plurals name="pdf2office_dense_pages">
        <item quantity="one">%d щільну сторінку перетворено у рядки.</item>
        <item quantity="few">%d щільні сторінки перетворено у рядки.</item>
        <item quantity="many">%d щільних сторінок перетворено у рядки.</item>
        <item quantity="other">%d щільних сторінок перетворено у рядки.</item>
    </plurals>
    <plurals name="pdf2office_unreadable_pages">
        <item quantity="one">Пропущено %d сторінку: не прочитано.</item>
        <item quantity="few">Пропущено %d сторінки: не прочитано.</item>
        <item quantity="many">Пропущено %d сторінок: не прочитано.</item>
        <item quantity="other">Пропущено %d сторінок: не прочитано.</item>
    </plurals>
    <plurals name="pdf2office_excel_scanned_skipped">
        <item quantity="one">%d відскановану сторінку без тексту пропущено.</item>
        <item quantity="few">%d відскановані сторінки без тексту пропущено.</item>
        <item quantity="many">%d відсканованих сторінок без тексту пропущено.</item>
        <item quantity="other">%d відсканованих сторінок без тексту пропущено.</item>
    </plurals>
    <string name="pdf2office_excel_no_tables">Таблиць немає; текст — по одному рядку.</string>

