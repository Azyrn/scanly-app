    <plurals name="pdf_tool_split_oversized_pages">
        <item quantity="one">%d сторінка сама по собі більша за ліміт розміру, тому має окремий файл.</item>
        <item quantity="few">%d сторінки самі по собі більші за ліміт розміру, тому кожна має окремий файл.</item>
        <item quantity="many">%d сторінок самі по собі більші за ліміт розміру, тому кожна має окремий файл.</item>
        <item quantity="other">%d сторінок самі по собі більші за ліміт розміру, тому кожна має окремий файл.</item>
