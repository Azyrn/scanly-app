        <item quantity="other">Створює %d файлів</item>
    </plurals>
    <plurals name="pdf_tool_split_keeps_pages">
        <item quantity="one">Зберігає %d сторінку</item>
        <item quantity="few">Зберігає %d сторінки</item>
        <item quantity="many">Зберігає %d сторінок</item>
        <item quantity="other">Зберігає %d сторінок</item>
    </plurals>

