    <!-- Compress image -->
    <string name="pdf_tool_img_compress_recommended">Recommended</string>
    <string name="pdf_tool_img_compress_recommended_body">Much smaller, still looks the same.</string>
    <string name="pdf_tool_img_compress_strong">Strong</string>
