    <!-- CustomProviderScreen.kt -->
    <string name="set_pro_required_title">A Pro feature</string>
    <string name="set_pro_required_message">Connecting your own AI provider is part of Scanly Pro. The fields below show exactly what you\'d set up — they unlock once you\'re on Pro. Upgrade, or redeem a key you already own, from the Account section in Settings.</string>
    <string name="set_custom_intro_body">Connect any AI provider. Pick the protocol it speaks, paste the endpoint URL, the model name and your API key, then test the connection.</string>
    <string name="set_custom_intro_hosts">Most hosts are OpenAI-compatible — Groq, OpenAI, OpenRouter, NVIDIA NIM, Together, Fireworks. Claude and Gemini have their own protocols, and a self-hosted server on your network works over plain http.</string>
    <plurals name="set_custom_intro_pdf_pages">
        <item quantity="one">Scanned PDFs go up to %1$d page at a time, since they travel as images in one request. Office documents still need Scanly AI.</item>
        <item quantity="other">Scanned PDFs go up to %1$d pages at a time, since they travel as images in one request. Office documents still need Scanly AI.</item>
    </plurals>
