    <string name="pdf_tool_split_delete_all">That’s every page. Leave at least one.</string>
    <string name="pdf_tool_split_every_label">Pages per file</string>
    <string name="pdf_tool_split_every_invalid">Enter a number from 1 to %1$d</string>
