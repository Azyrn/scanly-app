    <!-- CustomProviderScreen.kt -->
    <string name="set_pro_required_title">Función Pro</string>
    <string name="set_pro_required_message">Conectar tu propio proveedor de IA forma parte de Scanly Pro. Los campos de abajo muestran exactamente lo que configurarías; se desbloquean cuando tengas Pro. Mejora tu plan, o canjea una clave que ya tengas, desde la sección Cuenta de Ajustes.</string>
    <string name="set_custom_intro_body">Conecta cualquier proveedor de IA. Elige el protocolo que usa, pega la URL del endpoint, el nombre del modelo y tu clave de API, y luego prueba la conexión.</string>
    <string name="set_custom_intro_hosts">La mayoría de los hosts son compatibles con OpenAI: Groq, OpenAI, OpenRouter, NVIDIA NIM, Together, Fireworks. Claude y Gemini tienen sus propios protocolos, y un servidor propio en tu red funciona con http sin cifrar.</string>
    <string name="set_custom_intro_pdf_pages">Los PDF escaneados admiten hasta %1$d páginas a la vez, ya que se envían como imágenes en una sola solicitud. Los documentos de Office siguen necesitando Scanly AI.</string>
