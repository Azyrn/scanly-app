    <string name="set_pro_required_title">Función Pro</string>
    <string name="set_pro_required_message">Conectar tu propio proveedor de IA forma parte de Scanly Pro. Los campos muestran la configuración; se desbloquean con Pro. Mejora tu plan o canjea una clave desde la sección Cuenta de Ajustes.</string>
