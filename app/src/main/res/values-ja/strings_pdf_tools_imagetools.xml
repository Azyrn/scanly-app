    <!-- Compress image -->
    <string name="pdf_tool_img_compress_recommended">おすすめ</string>
    <string name="pdf_tool_img_compress_recommended_body">かなり小さく、見た目は同じ。</string>
    <string name="pdf_tool_img_compress_strong">強</string>
    <string name="pdf_tool_img_compress_strong_body">最も小さく、細部がぼやけることも。</string>
    <string name="pdf_tool_img_compress_light">軽</string>
    <string name="pdf_tool_img_compress_light_body">最高画質で、削減は少なめ。</string>
