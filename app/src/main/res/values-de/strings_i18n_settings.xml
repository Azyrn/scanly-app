    <!-- CustomProviderScreen.kt -->
    <string name="set_pro_required_title">Pro-Funktion</string>
    <string name="set_pro_required_message">Den eigenen KI-Anbieter zu verbinden gehört zu Scanly Pro. Die Felder unten zeigen, was du einrichten würdest – sie werden mit Pro freigeschaltet. Upgrade oder löse einen Schlüssel im Bereich Konto der Einstellungen ein.</string>
    <string name="set_custom_intro_body">Verbinde einen KI-Anbieter. Protokoll wählen, Endpunkt-URL, Modellname und API-Schlüssel einfügen, dann Verbindung testen.</string>
    <string name="set_custom_intro_hosts">Die meisten Anbieter sind OpenAI-kompatibel – Groq, OpenAI, OpenRouter, NVIDIA NIM, Together, Fireworks. Claude und Gemini haben eigene Protokolle. Selbst gehostete Server im Netzwerk gehen per einfachem http.</string>
    <string name="set_custom_intro_pdf_pages">Gescannte PDFs: bis zu %1$d Seiten auf einmal, als Bilder in einer Anfrage. Office-Dokumente brauchen Scanly AI.</string>
    <string name="set_section_protocol">Protokoll</string>
    <string name="set_section_endpoint">Endpunkt</string>
