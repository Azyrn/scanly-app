    <string name="set_endpoint_hint_openai">Endet meist auf /v1/chat/completions.</string>
    <string name="set_endpoint_hint_anthropic">Endet meist auf /v1/messages.</string>
    <string name="set_endpoint_hint_gemini">Der Host reicht – Modell und Pfad werden für dich ergänzt.</string>
