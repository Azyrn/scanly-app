    <string name="set_endpoint_url_label">URL du point de terminaison</string>
    <string name="set_endpoint_hint_cloudflare">Cloudflare Workers AI place votre identifiant de compte dans le chemin : collez l\'URL complète, identifiant inclus.</string>
    <string name="set_endpoint_hint_openai">Se termine généralement par /v1/chat/completions.</string>
    <string name="set_endpoint_hint_anthropic">Se termine généralement par /v1/messages.</string>
    <string name="set_endpoint_hint_gemini">L\'hôte suffit : le modèle et le chemin sont ajoutés pour vous.</string>
