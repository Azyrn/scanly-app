    <!-- CustomProviderScreen.kt -->
    <string name="set_pro_required_title">Fonctionnalité Pro</string>
    <string name="set_pro_required_message">Le raccordement de votre propre fournisseur d\'IA fait partie de Scanly Pro. Les champs ci-dessous montrent exactement ce que vous configurerez : ils se débloquent dès que vous êtes sur Pro. Passez à Pro, ou activez une clé que vous possédez déjà, depuis la section Compte des Paramètres.</string>
    <string name="set_custom_intro_body">Connectez n\'importe quel fournisseur d\'IA. Choisissez le protocole qu\'il utilise, collez l\'URL du point de terminaison, le nom du modèle et votre clé API, puis testez la connexion.</string>
    <string name="set_custom_intro_hosts">La plupart des hébergeurs sont compatibles OpenAI : Groq, OpenAI, OpenRouter, NVIDIA NIM, Together, Fireworks. Claude et Gemini ont leurs propres protocoles, et un serveur auto-hébergé sur votre réseau fonctionne en HTTP simple.</string>
    <string name="set_custom_intro_pdf_pages">Les PDF scannés sont envoyés jusqu\'à %1$d pages à la fois, car ils voyagent sous forme d\'images dans une seule requête. Les documents Office nécessitent toujours Scanly AI.</string>
    <string name="set_section_protocol">Protocole</string>
