        <item quantity="other">%d feuilles masquées retirées.</item>
    </plurals>
    <plurals name="excel2pdf_note_charts">
        <item quantity="one">%d graphique retiré.</item>
        <item quantity="many">%d graphiques retirés.</item>
        <item quantity="other">%d graphiques retirés.</item>
    </plurals>
