<?xml version="1.0" encoding="utf-8"?>
<!-- PDF tools: Excel to PDF (on-device .xlsx renderer). -->
<resources>
    <string name="excel2pdf_options_body">Chaque feuille visible devient des pages, dans l\'ordre du classeur. Les feuilles larges se poursuivent.</string>
    <string name="excel2pdf_convert">Convertir en PDF</string>

    <!-- Result notes: what the PDF had to leave out or simplify -->
