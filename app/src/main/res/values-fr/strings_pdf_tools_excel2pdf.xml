    </plurals>
    <plurals name="excel2pdf_note_page_cap">
        <item quantity="one">Le PDF s\'arrête à %d page ; le reste a été retiré.</item>
        <item quantity="many">Le PDF s\'arrête à %d pages ; le reste a été retiré.</item>
