<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and older: Scanly keeps nothing in Android backup (see
   data_extraction_rules.xml). android:allowBackup="false" already turns it off
   there; this is a second lock in case that flag is ever flipped.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
