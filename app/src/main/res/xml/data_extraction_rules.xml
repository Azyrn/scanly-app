<?xml version="1.0" encoding="utf-8"?><!--
   Scanly keeps nothing in Android backup: no Google Drive backup and no
   phone-to-phone transfer. Scans, scan history, settings (licence key, the
   user's own API key) and chats stay on this phone only.

   android:allowBackup="false" turns off cloud backup on every Android version
   and device transfer before Android 12. On Android 12+ device transfer ignores
   allowBackup, so these rules exclude every domain from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
