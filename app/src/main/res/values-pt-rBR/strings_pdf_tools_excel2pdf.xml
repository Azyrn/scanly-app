<?xml version="1.0" encoding="utf-8"?>
<!-- PDF tools: Excel to PDF (on-device .xlsx renderer). -->
<resources>
    <string name="excel2pdf_options_body">Cada planilha visível vira páginas do PDF, na ordem da pasta. Planilhas largas continuam nas seguintes.</string>
    <string name="excel2pdf_convert">Gerar PDF</string>

    <!-- Result notes: what the PDF had to leave out or simplify -->
