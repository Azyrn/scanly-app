    </plurals>
    <plurals name="excel2pdf_note_page_cap">
        <item quantity="one">PDF para em %d página; o resto foi omitido.</item>
        <item quantity="many">PDF para em %d páginas; o resto foi omitido.</item>
        <item quantity="other">PDF para em %d páginas; o resto foi omitido.</item>
