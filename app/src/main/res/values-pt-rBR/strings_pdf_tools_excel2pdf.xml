        <item quantity="many">%d planilhas ocultas omitidas.</item>
        <item quantity="other">%d planilhas ocultas omitidas.</item>
    </plurals>
    <plurals name="excel2pdf_note_charts">
        <item quantity="one">%d gráfico omitido.</item>
        <item quantity="many">%d gráficos omitidos.</item>
        <item quantity="other">%d gráficos omitidos.</item>
    </plurals>
    <plurals name="excel2pdf_note_pictures">
        <item quantity="one">%d imagem omitida.</item>
        <item quantity="many">%d imagens omitidas.</item>
        <item quantity="other">%d imagens omitidas.</item>
    </plurals>
    <string name="excel2pdf_note_formulas_cached">Fórmulas: último resultado salvo.</string>
    <plurals name="excel2pdf_note_formulas_missing">
        <item quantity="one">%d fórmula sem resultado salvo: em branco.</item>
