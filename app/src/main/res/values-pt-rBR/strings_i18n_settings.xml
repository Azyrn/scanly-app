    <!-- CustomProviderScreen.kt -->
    <string name="set_pro_required_title">Recurso Pro</string>
    <string name="set_pro_required_message">Conectar o seu próprio provedor de IA faz parte do Scanly Pro. Os campos abaixo mostram exatamente o que você configuraria; eles são liberados quando você tiver o Pro. Assine o Pro, ou resgate uma chave que você já tenha, na seção Conta das Configurações.</string>
    <string name="set_custom_intro_body">Conecte qualquer provedor de IA. Escolha o protocolo que ele usa, cole a URL do endpoint, o nome do modelo e sua chave de API, e depois teste a conexão.</string>
    <string name="set_custom_intro_hosts">A maioria dos hosts é compatível com OpenAI: Groq, OpenAI, OpenRouter, NVIDIA NIM, Together, Fireworks. Claude e Gemini têm protocolos próprios, e um servidor seu na rede funciona com http simples.</string>
    <string name="set_custom_intro_pdf_pages">PDFs escaneados vão até %1$d páginas por vez, pois são enviados como imagens em uma única solicitação. Documentos do Office ainda precisam do Scanly AI.</string>
