#!/usr/bin/env bash
# ./gradlew inside the scanly-build.slice memory budget (~/.config/systemd/user/scanly-build.slice), shared
# with scripts/detekt.sh: a build that outgrows it slows down or fails instead of pushing the PC into swap
# until it freezes (it did twice on 2026-11-07, the second time with Detekt running outside the box).
# The daemon it starts stays in the slice. One build at a time: runs take a shared lock, and none
# starts unless the PC has room (scripts/mem-preflight.sh).
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v systemd-run >/dev/null || [ -n "${CI:-}" ]; then exec ./gradlew "$@"; fi
. "$(dirname "$0")/mem-preflight.sh"
# A daemon started by a plain ./gradlew is outside the box; stop it so this run starts a capped one.
if pgrep -f '[G]radleDaemon' >/dev/null && ! systemctl --user list-units --type=scope --no-legend 'gradle-*' | grep -q running; then
  ./gradlew --stop -q
fi
exec flock -o "${XDG_RUNTIME_DIR:-/tmp}/scanly-build.lock" \
  systemd-run --user --scope --quiet --unit="gradle-$$" --slice=scanly-build.slice \
  -- nice -n 5 ./gradlew "$@"
